# Copy to .env and fill in. Never commit .env.
# Generate SECRET_KEY with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Discord ---------------------------------------------------------------
# Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Right-click your server > Copy Server ID (needs Developer Mode on)
GUILD_ID=
# Right-click the role > Copy Role ID. The bot's own role must sit ABOVE this one.
VERIFIED_ROLE_ID=
# Officers holding this role can use the /ac commands.
ADMIN_ROLE_ID=

# --- Google OAuth ----------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web -------------------------------------------------------------------
# No trailing slash. The Google redirect URI is always BASE_URL + /callback,
# and it must match the console entry exactly.
# Local development (Google allows http for localhost):
BASE_URL=http://localhost:8000
# On the VPS, once you have a hostname, switch to:
# BASE_URL=https://verify.example.com

# Signs the 10-minute verification links. Changing it invalidates links in flight.
SECRET_KEY=

# uvicorn listens on 127.0.0.1 only; Caddy proxies to this port.
PORT=8000

# --- Roster ----------------------------------------------------------------
# CSV with a header row containing an "email" column.
ROSTER_PATH=roster.csv
# "roster"      = email must appear in ROSTER_PATH (default)
# "domain_only" = accept any verified @bicol-u.edu.ph account, skip the roster
ROSTER_MODE=roster

# --- Kicking unverified members --------------------------------------------
# Days of grace once officers run /ac enforce start. Nothing happens until then.
KICK_AFTER_DAYS=14
# Optional: comma-separated role IDs that are never kicked, on top of the
# built-in exemptions (bots, verified members, ADMIN_ROLE_ID holders).
EXEMPT_ROLE_IDS=

# --- Storage ---------------------------------------------------------------
DB_PATH=anticheat.db
