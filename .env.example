# Copy to .env and fill in. Never commit .env.
# Generate SECRET_KEY with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Discord ---------------------------------------------------------------
# Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Right-click your server > Copy Server ID (needs Developer Mode on)
GUILD_ID=
# Right-click the role > Copy Role ID. The bot's own role must sit ABOVE this one.
VERIFIED_ROLE_ID=
# Officer roles, comma-separated. Holders can use the /ac commands and are
# never kicked. (The older single-role ADMIN_ROLE_ID is still accepted.)
# BU.gg: President, Internal VP, External VP, Secretary General, Deputy
# Secretary General, Auditing, Finance, Executive, Logistics, Public
# Information and Multimedia Officers, Technical Head, Executive Consultant,
# Moderator.
ADMIN_ROLE_IDS=

# --- Google OAuth ----------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web -------------------------------------------------------------------
# No trailing slash. The Google redirect URI is always BASE_URL + /callback,
# and it must match the console entry exactly.
# Local development (Google allows http for localhost):
BASE_URL=http://localhost:8000
# On the VPS, once you have a hostname, switch to:
# BASE_URL=https://verify.example.com

# Signs the 10-minute verification links. Changing it invalidates links in flight.
SECRET_KEY=

# uvicorn listens on 127.0.0.1 only; Caddy proxies to this port.
PORT=8000

# --- Roster ----------------------------------------------------------------
# CSV with a header row containing an "email" column.
ROSTER_PATH=roster.csv
# "roster"      = email must appear in ROSTER_PATH (default)
# "domain_only" = accept any verified @bicol-u.edu.ph account, skip the roster
ROSTER_MODE=roster

# --- Kicking unverified members --------------------------------------------
# Nothing happens until officers run /ac enforce start. From then on, every
# unverified member is on the clock:
#   KICK_AFTER_DAYS          members who join later, counted from joining
#   EXISTING_KICK_AFTER_DAYS members already here, counted from the clock start
KICK_AFTER_DAYS=3
EXISTING_KICK_AFTER_DAYS=14
# Days-left marks at which members on the clock are DM'd a reminder. Marks at
# or beyond a member's grace period are skipped for them. Leave empty to send
# no reminders (the welcome DM and the one-time notice still go out).
REMINDER_DAYS=7,3,1
# Optional: comma-separated role IDs that are never kicked and never DM'd to
# verify, on top of the built-in exemptions (bots, verified members, officer
# roles). BU.gg puts its Outsider and Graduate roles here.
EXEMPT_ROLE_IDS=
# Optional: comma-separated role IDs that are never kicked but are still DM'd
# to verify (same DMs, minus the removal warning). BU.gg puts Junior Councilor
# here.
NO_KICK_ROLE_IDS=

# --- Storage ---------------------------------------------------------------
DB_PATH=anticheat.db
